# ---- Server ----
PORT=3000
# Public base URL of this server (used to build Twilio media-stream websocket URL).
# For local dev, expose with a tunnel (e.g. ngrok) and put the https URL here.
PUBLIC_BASE_URL=https://your-tunnel.example.com
LOG_LEVEL=info

# Durable store (pick one). Default is in-memory (ephemeral).
# VOXDESK_DATA_FILE=./data/voxdesk.json
# VOXDESK_SQLITE_FILE=./data/voxdesk.sqlite

# ---- OpenAI (Realtime voice loop: STT + LLM + TTS) ----
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# ---- Twilio (telephony / phone numbers / SMS confirmations) ----
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_CALLER_ID=+1500...

# ---- ElevenLabs (TTS + voice cloning) [optional] ----
ELEVENLABS_API_KEY=...

# ---- Google Calendar [optional] ----
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=https://your-tunnel.example.com/api/integrations/google/callback

# ---- Microsoft Outlook Calendar [optional] ----
MICROSOFT_CLIENT_ID=...
MICROSOFT_CLIENT_SECRET=...
MICROSOFT_REDIRECT_URI=https://your-tunnel.example.com/api/integrations/outlook/callback
MICROSOFT_TENANT=common

# ---- Cal.com [optional; also connect per-org via API] ----
CALCOM_API_KEY=...
CALCOM_API_BASE=https://api.cal.com/v1

# ---- HubSpot CRM [optional] ----
HUBSPOT_CLIENT_ID=...
HUBSPOT_CLIENT_SECRET=...
HUBSPOT_REDIRECT_URI=https://your-tunnel.example.com/api/integrations/hubspot/callback

# ---- Stripe billing [optional] ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_SCALE=price_...
STRIPE_SUCCESS_URL=https://your-tunnel.example.com/?billing=success
STRIPE_CANCEL_URL=https://your-tunnel.example.com/?billing=cancel

# ---- Email confirmations (Resend) [optional; otherwise logged] ----
RESEND_API_KEY=re_...
EMAIL_FROM=VoxDesk <noreply@example.com>

# ---- Security ----
API_ADMIN_TOKEN=change-me-dev-token
STREAM_SECRET=change-me-stream-secret
# STREAM_AUTH=false
RATE_LIMIT_PER_MINUTE=120
