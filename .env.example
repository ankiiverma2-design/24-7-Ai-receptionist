# ---- Server ----
PORT=3000
# Public base URL of this server (used to build Twilio media-stream websocket URL).
# For local dev, expose with a tunnel (e.g. ngrok) and put the https URL here.
PUBLIC_BASE_URL=https://your-tunnel.example.com
LOG_LEVEL=info

# ---- OpenAI (Realtime voice loop: STT + LLM + TTS) ----
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# ---- Twilio (telephony / phone numbers) ----
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Optional: default caller ID for outbound calls
TWILIO_CALLER_ID=+1500...

# ---- ElevenLabs (TTS + voice cloning) [optional] ----
ELEVENLABS_API_KEY=...

# ---- Auth for the public API (simple bearer token for now) ----
API_ADMIN_TOKEN=change-me-dev-token
